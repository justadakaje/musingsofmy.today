---
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/latin-700.css';
import '@fontsource/montserrat/latin-700.css';
import '@fontsource/montserrat/latin-800.css';
import '@fontsource/montserrat/latin-900.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-500.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '../styles/global.css';
import { getImage } from 'astro:assets';
import avatar from '../assets/avatar.png';
import { SITE, SOCIAL, SUPPORT } from '../site';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or site-relative image for link previews. */
  image?: string;
  type?: 'website' | 'article';
  published?: Date;
  noindex?: boolean;
  nav?: 'writing' | 'podcasts' | 'about' | 'search' | null;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}
const { title, description = SITE.description, image = '/social.png', type = 'website', published, noindex = false, nav = null, jsonLd } = Astro.props;
const defaultLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.title,
    url: SITE.url,
    description: SITE.description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
    sameAs: SOCIAL.map((s) => s.href),
  },
];
const ld = jsonLd ?? defaultLd;
const fullTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} · ${SITE.description}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const icon32 = await getImage({ src: avatar, width: 32, height: 32, format: 'png' });
const icon180 = await getImage({ src: avatar, width: 180, height: 180, format: 'png' });
const brandImg = await getImage({ src: avatar, width: 64, height: 64, format: 'webp' });
const sigImg = await getImage({ src: avatar, width: 104, height: 104, format: 'webp' });
const metaDesc = description.length > 200 ? description.slice(0, 197).replace(/\s+\S*$/, '') + '…' : description;
const links = [
  { id: 'writing', label: 'writing', href: '/archive/' },
  { id: 'podcasts', label: 'podcasts', href: '/podcasts/' },
  { id: 'projects', label: 'projects', href: '/#projects' },
  { id: 'about', label: 'about', href: '/about/' },
  { id: 'search', label: 'search', href: '/search/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" sizes="32x32" href={icon32.src} />
    <link rel="apple-touch-icon" href={icon180.src} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content="#05070a" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? SITE.title} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    <meta name="author" content={SITE.author} />
    <script type="application/ld+json" set:html={JSON.stringify(ld)} />
    {SITE.cloudflareAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: SITE.cloudflareAnalyticsToken })}
      />
    )}
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#content">skip to content</a>
    <header class="nav">
      <div class="wrap">
        <a class="brand" href="/" aria-label={`${SITE.title}, home`}>
          <img src={brandImg.src} alt="" width="30" height="30" />
          <span>musingsofmy<span class="tld">.today</span><span class="cursor" aria-hidden="true">_</span></span>
        </a>
        <nav aria-label="Main">
          {links.map((l) => <a href={l.href} aria-current={nav === l.id ? 'page' : undefined}>{l.label}</a>)}
        </nav>
        <span class="spacer"></span>
        <a class="btn ghost clip" href="/rss.xml">rss</a>
        <button
          type="button"
          class="btn ghost clip nav-menu-btn"
          id="drawer-open"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="mobile-nav-drawer"
        ><span aria-hidden="true">≡</span> menu</button>
        <a class="btn clip" href="/subscribe/">subscribe →</a>
      </div>
    </header>
    <dialog class="nav-drawer" id="mobile-nav-drawer" aria-label="Site navigation">
      <div class="nav-drawer-scroller">
        <nav class="nav-drawer-sheet" aria-label="Mobile">
          <div class="nav-drawer-head">
            <span class="mono">// menu</span>
            <button type="button" class="btn ghost clip" id="drawer-close" aria-label="Close menu" autofocus>✕ close</button>
          </div>
          <ul class="nav-drawer-links">
            {links.map((l) => (
              <li><a href={l.href} aria-current={nav === l.id ? 'page' : undefined}>{l.label}</a></li>
            ))}
          </ul>
          <div class="nav-drawer-actions">
            <a class="btn ghost clip" href="/rss.xml">rss</a>
            <a class="btn clip" href="/subscribe/">subscribe →</a>
          </div>
        </nav>
      </div>
    </dialog>
    <div class="main" id="content">
      <slot />
    </div>
    <footer>
      <div class="wrap">
        <div>
          <div class="sig">
            <img src={sigImg.src} alt="" width="52" height="52" />
            <div><b>Kenneth Henseler</b><span>KenHenChan · Indianapolis, IN</span></div>
          </div>
          <div class="motto">Real bugs, real fixes.</div>
          <div class="colophon">Built with Astro from Markdown in <a href="https://github.com/justadakaje/musingsofmy.today">a public repo</a>.</div>
        </div>
        <div>
          <h5>// elsewhere</h5>
          <ul>{SOCIAL.map((s) => <li><a href={s.href}>{s.label}</a></li>)}</ul>
        </div>
        <div>
          <h5>// support the work</h5>
          <ul>
            {SUPPORT.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
            <li><a href="/subscribe/">email newsletter</a></li>
          </ul>
        </div>
      </div>
    </footer>
    <script>
      const drawer = document.getElementById('mobile-nav-drawer') as HTMLDialogElement | null;
      const openBtn = document.getElementById('drawer-open') as HTMLButtonElement | null;
      const closeBtn = document.getElementById('drawer-close') as HTMLButtonElement | null;
      const scroller = drawer?.querySelector('.nav-drawer-scroller') as HTMLElement | null;
      const sheet = drawer?.querySelector('.nav-drawer-sheet') as HTMLElement | null;

      if (drawer && openBtn && closeBtn && scroller && sheet) {
        async function openDrawer() {
          drawer!.showModal();
          if (!CSS.supports('scroll-initial-target', 'nearest')) {
            scroller!.scrollTo({ left: scroller!.offsetWidth, behavior: 'instant' as ScrollBehavior });
            await new Promise<void>((r) => requestAnimationFrame(() => requestAnimationFrame(() => r())));
          }
          scroller!.scrollTo({ left: 0, behavior: 'auto' });
        }

        function closeDrawer() {
          scroller!.scrollTo({ left: scroller!.offsetWidth, behavior: 'auto' });
        }

        function onDrawerOpened() {
          openBtn!.setAttribute('aria-expanded', 'true');
        }

        function onDrawerClosed() {
          if (drawer!.open) drawer!.close();
          openBtn!.setAttribute('aria-expanded', 'false');
        }

        if (!CSS.supports('animation-timeline: scroll()')) {
          scroller.addEventListener(
            'scroll',
            () => {
              const width = sheet.offsetWidth || 1;
              const ratio = Math.max(0, Math.min(1, 1 - scroller.scrollLeft / width));
              drawer.style.setProperty('--drawer-backdrop', String(ratio));
            },
            { passive: true },
          );
        }

        const visibleThreshold = 1 / Math.max(1, window.innerWidth);
        const observer = new IntersectionObserver(
          (entries) => {
            const entry = entries.at(-1);
            if (!entry) return;
            if (entry.intersectionRatio < visibleThreshold) onDrawerClosed();
            if (entry.intersectionRatio === 1) onDrawerOpened();
          },
          { root: drawer, threshold: [visibleThreshold, 1] },
        );
        observer.observe(sheet);

        openBtn.addEventListener('click', () => {
          void openDrawer();
        });
        closeBtn.addEventListener('click', closeDrawer);

        drawer.addEventListener('click', (event) => {
          if (event.target instanceof Node && !sheet.contains(event.target)) {
            closeDrawer();
          }
        });

        drawer.addEventListener('cancel', (event) => {
          if (event.cancelable) {
            event.preventDefault();
            closeDrawer();
          }
        });

        sheet.addEventListener('click', (event) => {
          const target = event.target;
          if (target instanceof Element && target.closest('a[href]')) {
            closeDrawer();
          }
        });
      }
    </script>
  </body>
</html>
