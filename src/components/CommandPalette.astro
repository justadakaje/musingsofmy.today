---
/**
 * Global Cmd+K / `/` instant command palette & Pagefind search dialog.
 * Uses native <dialog closedby="any">, Invoker Commands, and zero innerHTML sinks.
 */
import { PROJECTS } from '../data/home';
import { SECTIONS, SHOWS } from '../site';

interface StaticJumpItem {
  kind: 'section' | 'show' | 'project' | 'page';
  title: string;
  url: string;
  subtitle: string;
  keywords: string;
  external?: boolean;
}

const sectionItems: StaticJumpItem[] = SECTIONS.map((s) => ({
  kind: 'section',
  title: s.label,
  url: `/section/${s.id}/`,
  subtitle: s.blurb,
  keywords: [s.id, s.hint ?? '', ...s.categories.map((c) => c.name)].join(' '),
}));

const showItems: StaticJumpItem[] = Object.values(SHOWS).map((show) => ({
  kind: 'show',
  title: show.name,
  url: '/podcasts/',
  subtitle: `${show.kicker} — ${show.blurb}`,
  keywords: `${show.id} ${show.short} podcast`,
}));

const projectItems: StaticJumpItem[] = PROJECTS.map((p) => {
  const href = p.links[0]?.href ?? '/#projects';
  return {
    kind: 'project',
    title: p.name,
    url: href,
    subtitle: `${p.status.label} — ${p.blurb}`,
    keywords: `${p.facts.join(' ')} ${p.links.map((l) => l.label).join(' ')}`,
    external: href.startsWith('http'),
  };
});

const pageItems: StaticJumpItem[] = [
  { kind: 'page', title: 'All Writing', url: '/archive/', subtitle: 'Chronological post archive by year', keywords: 'archive posts index' },
  { kind: 'page', title: 'Podcasts', url: '/podcasts/', subtitle: 'Runtime Reality & The Chronos Archive episodes', keywords: 'audio shows episodes' },
  { kind: 'page', title: 'Now', url: '/now/', subtitle: 'What is active right now', keywords: 'status current focus' },
  { kind: 'page', title: 'Uses', url: '/uses/', subtitle: 'Hardware, software, DAW & studio stack', keywords: 'gear setup tools stack' },
  { kind: 'page', title: 'About', url: '/about/', subtitle: 'About Kenneth Henseler & the site', keywords: 'bio author colophon' },
  { kind: 'page', title: 'Contact', url: '/contact/', subtitle: 'Ways to reach out and social links', keywords: 'email social discord' },
  { kind: 'page', title: 'Subscribe', url: '/subscribe/', subtitle: 'Newsletter & feed subscription', keywords: 'newsletter email updates' },
  { kind: 'page', title: 'RSS Feed', url: '/rss.xml', subtitle: 'Full-site XML syndication feed', keywords: 'atom xml feed' },
];

const staticItems: StaticJumpItem[] = [
  ...sectionItems,
  ...pageItems,
  ...showItems,
  ...projectItems,
];

const serializedStatic = JSON.stringify(staticItems).replace(/</g, '\\u003c');
---
<dialog
  id="cmd-palette"
  class="cmd-dialog clip"
  closedby="any"
  aria-labelledby="cmd-palette-title"
>
  <h1 id="cmd-palette-title" class="sr-only">Search and quick navigation</h1>
  <div class="cmd-head">
    <span class="cmd-prompt" aria-hidden="true">&gt;_</span>
    <input
      id="cmd-input"
      class="cmd-input"
      type="search"
      placeholder="Search posts or jump to a section, show, or project…"
      autocomplete="off"
      spellcheck="false"
      autofocus
      aria-controls="cmd-results"
    />
    <button
      type="button"
      class="btn ghost clip cmd-close"
      command="close"
      commandfor="cmd-palette"
      aria-label="Close command palette"
    >
      esc
    </button>
  </div>
  <div class="cmd-status" id="cmd-status" role="status" aria-live="polite">
    quick jumps
  </div>
  <div class="cmd-results" id="cmd-results"></div>
  <div class="cmd-foot">
    <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
    <span><kbd>↵</kbd> open</span>
    <span><kbd>esc</kbd> close</span>
    <span class="cmd-foot-right"><kbd>/</kbd> or <kbd>⌘K</kbd></span>
  </div>
  <script type="application/json" id="cmd-static-data" set:html={serializedStatic} />
</dialog>

<script>
  interface StaticItem {
    kind: 'section' | 'show' | 'project' | 'page';
    title: string;
    url: string;
    subtitle: string;
    keywords: string;
    external?: boolean;
  }

  interface PaletteRow {
    kind: 'post' | 'section' | 'show' | 'project' | 'page';
    title: string;
    url: string;
    subtitle: string;
    external?: boolean;
  }

  interface PagefindResultData {
    url: string;
    meta?: { title?: string };
    excerpt?: string;
  }

  interface PagefindModule {
    debouncedSearch: (
      query: string,
      options?: Record<string, unknown>,
      debounceMs?: number,
    ) => Promise<{ results: Array<{ data: () => Promise<PagefindResultData> }> } | null>;
  }

  (() => {
    const dialog = document.getElementById('cmd-palette') as HTMLDialogElement | null;
    const input = document.getElementById('cmd-input') as HTMLInputElement | null;
    const resultsEl = document.getElementById('cmd-results') as HTMLElement | null;
    const statusEl = document.getElementById('cmd-status') as HTMLElement | null;
    const dataEl = document.getElementById('cmd-static-data');
    if (!dialog || !input || !resultsEl || !statusEl || !dataEl) return;

    let staticItems: StaticItem[] = [];
    try {
      staticItems = JSON.parse(dataEl.textContent || '[]') as StaticItem[];
    } catch {
      staticItems = [];
    }

    let pfPromise: Promise<PagefindModule | null> | null = null;
    let pfUnavailable = false;
    let searchSeq = 0;
    let activeIndex = -1;

    function loadPagefind(): Promise<PagefindModule | null> {
      if (pfPromise) return pfPromise;
      const pfUrl = '/pagefind/pagefind.js';
      pfPromise = (new Function('u', 'return import(u)')(pfUrl) as Promise<PagefindModule>).catch(() => {
        pfUnavailable = true;
        return null;
      });
      return pfPromise;
    }

    function filterStatic(query: string): PaletteRow[] {
      const tokens = query.toLowerCase().split(/\s+/).filter(Boolean);
      const matched =
        tokens.length === 0
          ? staticItems
          : staticItems.filter((item) => {
              const hay = `${item.kind} ${item.title} ${item.url} ${item.subtitle} ${item.keywords}`.toLowerCase();
              return tokens.every((tok) => hay.includes(tok));
            });

      return matched.map((item) => ({
        kind: item.kind,
        title: item.title,
        url: item.url,
        subtitle: item.subtitle,
        external: item.external,
      }));
    }

    function setActive(nextIndex: number, shouldScroll = true) {
      const links = Array.from(resultsEl!.querySelectorAll<HTMLAnchorElement>('.cmd-item'));
      if (links.length === 0) {
        activeIndex = -1;
        input!.removeAttribute('aria-activedescendant');
        return;
      }
      const wrapped = ((nextIndex % links.length) + links.length) % links.length;
      activeIndex = wrapped;
      links.forEach((link, idx) => {
        const isActive = idx === wrapped;
        link.dataset.active = isActive ? 'true' : 'false';
        if (isActive) {
          input!.setAttribute('aria-activedescendant', link.id);
          if (shouldScroll) {
            link.scrollIntoView({ block: 'nearest' });
          }
        }
      });
    }

    function renderRows(rows: PaletteRow[], statusText: string) {
      statusEl!.textContent = statusText;
      const frag = document.createDocumentFragment();

      if (rows.length === 0) {
        const empty = document.createElement('p');
        empty.className = 'cmd-empty';
        empty.textContent = 'No matching posts or quick jumps.';
        frag.appendChild(empty);
        resultsEl!.replaceChildren(frag);
        activeIndex = -1;
        input!.removeAttribute('aria-activedescendant');
        return;
      }

      rows.forEach((row, idx) => {
        const link = document.createElement('a');
        link.id = `cmd-item-${idx}`;
        link.className = 'cmd-item';
        link.href = row.url;
        link.dataset.active = idx === 0 ? 'true' : 'false';
        if (row.external) {
          link.target = '_blank';
          link.rel = 'noopener noreferrer';
        }

        const top = document.createElement('div');
        top.className = 'cmd-item-top';

        const badge = document.createElement('span');
        badge.className = `cmd-badge cmd-badge-${row.kind}`;
        badge.textContent = row.kind;
        top.appendChild(badge);

        const title = document.createElement('span');
        title.className = 'cmd-title';
        title.textContent = row.title;
        top.appendChild(title);

        const path = document.createElement('span');
        path.className = 'cmd-url';
        path.textContent = row.external ? `${row.url} ↗` : row.url;
        top.appendChild(path);

        link.appendChild(top);

        if (row.subtitle) {
          const excerpt = document.createElement('p');
          excerpt.className = 'cmd-excerpt';
          excerpt.textContent = row.subtitle;
          link.appendChild(excerpt);
        }

        link.addEventListener('pointerenter', () => {
          setActive(idx, false);
        });

        frag.appendChild(link);
      });

      resultsEl!.replaceChildren(frag);
      setActive(0, false);
    }

    async function runSearch() {
      const q = input!.value.trim();
      const seq = ++searchSeq;
      const staticRows = filterStatic(q);

      if (q.length < 2) {
        const label = q.length === 0 ? `quick jumps · ${staticRows.length}` : `${staticRows.length} quick jumps`;
        renderRows(staticRows, label);
        return;
      }

      renderRows(staticRows, pfUnavailable ? `${staticRows.length} quick jumps` : 'searching posts…');

      const pf = await loadPagefind();
      if (seq !== searchSeq) return;
      if (!pf) {
        renderRows(
          staticRows,
          staticRows.length > 0
            ? `${staticRows.length} quick jumps (post index available after build)`
            : 'post search index available after build',
        );
        return;
      }

      const search = await pf.debouncedSearch(q, {}, 120);
      if (!search || seq !== searchSeq) return;

      const topHits = search.results.slice(0, 8);
      const hitData = await Promise.all(topHits.map((r) => r.data()));
      if (seq !== searchSeq) return;

      const postRows: PaletteRow[] = hitData.map((item) => ({
        kind: 'post',
        title: item.meta?.title?.trim() || item.url,
        url: item.url,
        subtitle: (item.excerpt ?? '').replace(/<[^>]+>/g, ''),
      }));

      const combined = [...postRows, ...staticRows];
      const parts: string[] = [];
      if (postRows.length > 0) parts.push(`${postRows.length} post${postRows.length === 1 ? '' : 's'}`);
      if (staticRows.length > 0) parts.push(`${staticRows.length} jump${staticRows.length === 1 ? '' : 's'}`);
      renderRows(combined, parts.length > 0 ? parts.join(' · ') : '0 results');
    }

    function onOpen() {
      loadPagefind();
      void runSearch();
      requestAnimationFrame(() => {
        input!.focus();
        input!.select();
      });
    }

    function openPalette() {
      if (dialog!.open) return;
      dialog!.showModal();
    }

    // React to all open transitions (native command="show-modal", Cmd+K, /, fallback)
    const observer = new MutationObserver((mutations) => {
      for (const m of mutations) {
        if (m.attributeName === 'open' && dialog!.open) {
          onOpen();
        }
      }
    });
    observer.observe(dialog, { attributes: true, attributeFilter: ['open'] });

    dialog.addEventListener('close', () => {
      dialog.returnValue = '';
    });

    input.addEventListener('input', () => {
      void runSearch();
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        setActive(activeIndex + 1, true);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        setActive(activeIndex - 1, true);
      } else if (e.key === 'Enter') {
        const activeLink = resultsEl.querySelector<HTMLAnchorElement>('.cmd-item[data-active="true"]');
        if (activeLink) {
          e.preventDefault();
          dialog.close();
          activeLink.click();
        }
      }
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault();
        if (dialog.open) {
          dialog.close();
        } else if (!document.querySelector('dialog:modal')) {
          openPalette();
        }
        return;
      }

      if (e.key === '/' && !e.metaKey && !e.ctrlKey && !e.altKey) {
        const target = e.target as HTMLElement | null;
        if (
          target &&
          (target.tagName === 'INPUT' ||
            target.tagName === 'TEXTAREA' ||
            target.tagName === 'SELECT' ||
            target.isContentEditable)
        ) {
          return;
        }
        if (dialog.open || document.querySelector('dialog:modal')) return;
        e.preventDefault();
        openPalette();
      }
    });

    // Fallback for browsers without <dialog closedby="any">
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      const outside = (e: PointerEvent, el: HTMLDialogElement) => {
        const r = el.getBoundingClientRect();
        return e.clientX < r.left || e.clientX > r.right || e.clientY < r.top || e.clientY > r.bottom;
      };
      let pressedOutside = false;
      dialog.addEventListener('pointerdown', (e) => {
        if (dialog.open) pressedOutside = outside(e, dialog);
      });
      dialog.addEventListener('pointerup', (e) => {
        if (dialog.open && pressedOutside && outside(e, dialog)) dialog.close();
        pressedOutside = false;
      });
    }

    // Fallback for browsers without Invoker Commands (command / commandfor)
    if (!('commandForElement' in HTMLButtonElement.prototype)) {
      document.addEventListener('click', (e) => {
        const btn = (e.target as Element | null)?.closest<HTMLButtonElement>(
          'button[commandfor="cmd-palette"]',
        );
        if (!btn) return;
        const cmd = btn.getAttribute('command');
        if (cmd === 'show-modal' && !dialog.open) {
          openPalette();
        } else if (cmd === 'close' && dialog.open) {
          dialog.close();
        }
      });
    }
  })();
</script>

<style>
  dialog.cmd-dialog {
    padding: 0;
    border: 1px solid var(--line-strong);
    background: var(--khc-color-bg-overlay, rgba(5, 12, 18, 0.9));
    backdrop-filter: blur(14px);
    color: var(--read);
    box-shadow: var(--khc-shadow-lg), var(--khc-shadow-glow);
    width: min(680px, calc(100vw - 32px));
    max-width: 680px;
    max-height: min(76vh, 620px);
    margin: min(11vh, 88px) auto auto;
    overflow: hidden;
  }

  dialog.cmd-dialog[open] {
    display: flex;
    flex-direction: column;
  }

  dialog.cmd-dialog:modal {
    overscroll-behavior: contain;
  }

  dialog.cmd-dialog::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
    background: rgba(2, 6, 10, 0.78);
    backdrop-filter: blur(6px);
  }

  .cmd-head {
    display: flex;
    align-items: center;
    gap: var(--khc-space-sm);
    padding: 12px 16px;
    border-bottom: 1px solid var(--line);
    background: rgba(10, 18, 24, 0.92);
  }

  .cmd-head:focus-within {
    border-bottom-color: var(--cyan);
    box-shadow: inset 0 -1px 0 var(--cyan);
  }

  .cmd-prompt {
    font: 700 14px var(--mono);
    color: var(--cyan);
    user-select: none;
    flex-shrink: 0;
  }

  .cmd-input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--text);
    font: 400 15px/1.4 var(--mono);
    padding: 6px 0;
    appearance: none;
  }

  .cmd-input::placeholder {
    color: var(--subtle);
  }

  .cmd-input:focus-visible {
    outline: none;
  }

  .cmd-close {
    flex-shrink: 0;
    padding: 5px 10px;
    font-size: 11.5px;
  }

  .cmd-status {
    padding: 7px 16px;
    border-bottom: 1px solid var(--line-quiet);
    font: 500 11.5px var(--mono);
    color: var(--gold);
    letter-spacing: 0.04em;
    background: rgba(5, 7, 10, 0.55);
  }

  .cmd-results {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 6px 0;
    scrollbar-width: thin;
    scrollbar-color: var(--cyan-dim) transparent;
  }

  .cmd-results :global(.cmd-empty) {
    margin: 0;
    padding: 24px 18px;
    font: 400 13.5px var(--mono);
    color: var(--subtle);
    text-align: center;
  }

  .cmd-results :global(.cmd-item) {
    display: block;
    padding: 11px 16px;
    border-left: 2px solid transparent;
    border-bottom: 1px solid var(--line-quiet);
    color: var(--read);
    text-decoration: none;
    transition: background 100ms ease, border-color 100ms ease;
  }

  .cmd-results :global(.cmd-item:last-child) {
    border-bottom: 0;
  }

  .cmd-results :global(.cmd-item[data-active='true']),
  .cmd-results :global(.cmd-item:hover) {
    background: rgba(34, 211, 238, 0.09);
    border-left-color: var(--cyan);
  }

  .cmd-results :global(.cmd-item-top) {
    display: flex;
    align-items: baseline;
    gap: 10px;
    min-width: 0;
  }

  .cmd-results :global(.cmd-badge) {
    flex-shrink: 0;
    font: 600 10.5px var(--mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 1px 6px;
    border: 1px solid var(--line-strong);
    color: var(--cyan-bright);
  }

  .cmd-results :global(.cmd-badge-section) {
    color: var(--gold-bright);
    border-color: rgba(224, 169, 59, 0.5);
  }

  .cmd-results :global(.cmd-badge-show) {
    color: #f0abfc;
    border-color: rgba(240, 171, 252, 0.45);
  }

  .cmd-results :global(.cmd-badge-project) {
    color: var(--success);
    border-color: rgba(52, 211, 153, 0.45);
  }

  .cmd-results :global(.cmd-badge-page) {
    color: var(--muted);
    border-color: var(--line-quiet);
  }

  .cmd-results :global(.cmd-title) {
    font: 600 15px/1.35 var(--body);
    color: var(--text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cmd-results :global(.cmd-url) {
    margin-left: auto;
    flex-shrink: 0;
    max-width: 42%;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 400 11.5px var(--mono);
    color: var(--subtle);
  }

  .cmd-results :global(.cmd-excerpt) {
    margin: 4px 0 0;
    font: 400 13px/1.45 var(--body);
    color: var(--muted);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .cmd-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 16px;
    padding: 9px 16px;
    border-top: 1px solid var(--line);
    background: rgba(5, 7, 10, 0.72);
    font: 400 11.5px var(--mono);
    color: var(--subtle);
  }

  .cmd-foot kbd {
    display: inline-block;
    padding: 1px 5px;
    margin-right: 3px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--muted);
    font: 500 11px var(--mono);
  }

  .cmd-foot-right {
    margin-left: auto;
  }

  @media (max-width: 640px) {
    dialog.cmd-dialog {
      width: calc(100vw - 20px);
      margin-top: 16px;
      max-height: 84dvh;
    }

    .cmd-results :global(.cmd-url) {
      display: none;
    }

    .cmd-foot-right {
      display: none;
    }
  }
</style>
