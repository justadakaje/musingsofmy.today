// Cloudflare Workers static assets: the successor to Pages for new static sites.
// No Worker script: Cloudflare serves dist/ directly, applying dist/_redirects and
// dist/_headers (generated by astro.config.mjs). Deploy with `npm run deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "musingsofmy-today",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    // /about → /about/ (as WordPress did); posts are already /YYYY/MM/DD/slug/.
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get dist/404.html with a real 404 status.
    "not_found_handling": "404-page"
  },
  // <name>.<account>.workers.dev stays on as the preview until the custom domain is attached.
  "workers_dev": true,
  // Per-version and per-branch preview URLs (wrangler versions upload --preview-alias …).
  "preview_urls": true
}
