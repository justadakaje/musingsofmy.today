// Cloudflare Workers static assets + minimal /api/* Worker entrypoint.
// Static pages/assets serve directly from dist/ (with dist/_redirects and dist/_headers);
// only /api/* invokes src/worker/index.ts (`run_worker_first`). Deploy with `npm run deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "musingsofmy-today",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // /about → /about/ (as WordPress did); posts are already /YYYY/MM/DD/slug/.
    "html_handling": "auto-trailing-slash",
    // Unknown URLs get dist/404.html with a real 404 status.
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // The real domain. www is a proxied CNAME with a Page Rule that 301s to the apex,
  // so it needs no route here.
  "routes": [{ "pattern": "musingsofmy.today", "custom_domain": true }],
  // <name>.<account>.workers.dev stays on (noindex) for previews and checks.
  "workers_dev": true,
  // Per-version and per-branch preview URLs (wrangler versions upload --preview-alias …).
  "preview_urls": true
}
